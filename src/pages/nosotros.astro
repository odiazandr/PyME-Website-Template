---
import ContactCTA from "../components/sections/ContactCTA.astro";
import PageHero from "../components/sections/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import { business } from "../data";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Nosotros"
  description={`Conoce la información pública de ${business.publicName}.`}
>
  <PageHero
    title="Nosotros"
    description="Conoce la información pública del negocio."
  />
  <Section tone="surface">
    <Container size="sm">
      <div class="u-flow">
        <h2>Información útil para conocer el negocio</h2>
        <p>
          Esta ruta explica quién opera el negocio, a quién sirve y qué
          información pública respalda su trabajo.
        </p>
        <p>
          La información publicada se mantiene clara, concreta y útil para las
          personas que desean conocer el negocio.
        </p>
      </div>
    </Container>
  </Section>
  <ContactCTA />
</BaseLayout>
