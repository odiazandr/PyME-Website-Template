---
import { contactRoute, routeFor } from "../config/navigation.ts";
import ContactCTA from "../components/sections/ContactCTA.astro";
import Locations from "../components/sections/Locations.astro";
import PageHero from "../components/sections/PageHero.astro";
import ServicesGrid from "../components/sections/ServicesGrid.astro";
import { business, locations, services } from "../data";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={business.publicName}
  description={business.description}
  structuredData
>
  <PageHero
    title={business.publicName}
    description={business.description}
    primaryAction={{ href: contactRoute, label: "Contactar" }}
    secondaryAction={{ href: routeFor("services"), label: "Ver servicios" }}
  />
  <ServicesGrid services={services.filter(({ featured }) => featured)} />
  <Locations locations={locations} />
  <ContactCTA />
</BaseLayout>
