---
import { site } from "../config/site";
import { business, templateMetadata } from "../data";

const title = business.publicName;
const description = business.description;
---

<!doctype html>
<html lang={site.defaultLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Navegación principal">
        <a href="/">{title}</a>
      </nav>
    </header>
    <main>
      <h1>{title}</h1>
      <p>{description}</p>
      <p>
        La base de ejecución y los datos canónicos están conectados. El diseño
        se incorpora en la siguiente fase.
      </p>
    </main>
    <footer>
      <p>Plantilla {templateMetadata.templateVersion} en desarrollo.</p>
    </footer>
  </body>
</html>
