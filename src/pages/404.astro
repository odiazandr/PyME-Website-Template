---
import { contactRoute } from "../config/navigation.ts";
import PageHero from "../components/sections/PageHero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada"
  description="La página solicitada no existe."
  noindex
>
  <PageHero
    title="Página no encontrada"
    description="La dirección puede estar incompleta o la página pudo cambiar."
    primaryAction={{ href: "/", label: "Ir al inicio" }}
    secondaryAction={{ href: contactRoute, label: "Contactar" }}
  />
</BaseLayout>
