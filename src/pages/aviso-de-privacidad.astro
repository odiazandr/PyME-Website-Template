---
import PageHero from "../components/sections/PageHero.astro";
import Container from "../components/ui/Container.astro";
import Section from "../components/ui/Section.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PrivacyNotice from "../content/legal/aviso-de-privacidad.md";
---

<BaseLayout
  title="Aviso de privacidad"
  description="Espacio reservado para el aviso de privacidad aprobado del negocio."
  noindex
>
  <PageHero
    title="Aviso de privacidad"
    description="Este contenido de referencia no constituye asesoría legal ni un aviso aprobado para producción."
  />
  <Section tone="surface">
    <Container size="sm">
      <div class="u-flow">
        <PrivacyNotice />
      </div>
    </Container>
  </Section>
</BaseLayout>
