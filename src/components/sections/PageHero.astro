---
import ButtonLink from "../ui/ButtonLink.astro";
import Container from "../ui/Container.astro";
import Section from "../ui/Section.astro";

interface Props {
  title: string;
  description: string;
  primaryAction?: { href: string; label: string };
  secondaryAction?: { href: string; label: string };
}

const { title, description, primaryAction, secondaryAction } = Astro.props;
---

<Section class="page-hero">
  <Container>
    <div class="hero-grid">
      <h1>{title}</h1>
      <div class="hero-copy u-flow">
        <p>{description}</p>
        {
          (primaryAction || secondaryAction) && (
            <div class="u-cluster actions">
              {primaryAction && (
                <ButtonLink href={primaryAction.href}>
                  {primaryAction.label}
                </ButtonLink>
              )}
              {secondaryAction && (
                <ButtonLink href={secondaryAction.href} variant="secondary">
                  {secondaryAction.label}
                </ButtonLink>
              )}
            </div>
          )
        }
      </div>
    </div>
  </Container>
</Section>

<style>
  .page-hero {
    min-height: min(38rem, calc(100svh - 8rem));
    display: grid;
    align-items: center;
  }

  .hero-grid {
    display: grid;
    gap: var(--space-8);
  }

  .hero-copy {
    --flow-space: var(--space-6);
    align-self: end;
  }

  .hero-copy > p {
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  @media (min-width: 48rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(18rem, 0.75fr);
      gap: clamp(var(--space-12), 7vw, var(--space-24));
      align-items: end;
    }
  }
</style>
