---
import { contextualRoutes } from "../../config/navigation.ts";
---

<aside class="form-notice" aria-label="Privacidad del formulario">
  <p>
    Usa este formulario únicamente para datos de contacto y una consulta
    general. No compartas información médica, financiera ni otros datos
    sensibles.
  </p>
  <p>
    Al enviar, reconoces el <a href={contextualRoutes.privacy}
      >aviso de privacidad</a
    >.
  </p>
</aside>

<style>
  .form-notice {
    padding-inline-start: var(--space-4);
    border-inline-start: 1px solid var(--color-accent);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
  p + p {
    margin-block-start: var(--space-2);
  }
</style>
